      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#4e4e4e",
        "line-width": 1.4
      }
    },
    {
      "id": "street_minor",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "residential",
            "unclassified",
            "living_street"
