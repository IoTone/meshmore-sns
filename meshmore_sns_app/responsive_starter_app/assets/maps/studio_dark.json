{
  "version": 8,
  "name": "Studio Dark (Shortbread)",
  "sources": {
    "openstreetmap": {
      "type": "vector",
      "tiles": [
        "https://vector.openstreetmap.org/shortbread_v1/{z}/{x}/{y}.mvt"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#141414"
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#1b2a36"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "water_polygons",
      "minzoom": 4,
      "paint": {
        "fill-color": "#1b2a36"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "water_lines",
      "minzoom": 8,
      "paint": {
        "line-color": "#22394a",
        "line-width": 1.2
      }
    },
    {
      "id": "land_forest",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "land",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "forest",
            "wood"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#1d291e"
      }
    },
    {
      "id": "land_grass",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "land",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "grass",
            "meadow",
            "park",
            "village_green",
            "recreation_ground",
            "golf_course",
            "pitch",
            "orchard",
            "allotments",
            "cemetery",
            "heath",
            "scrub"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#202e21"
      }
    },
    {
      "id": "land_sand",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "land",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "sand",
            "beach"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#2b2a24"
      }
    },
    {
      "id": "land_rock",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "land",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Polygon"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "rock",
            "scree",
            "bare_rock",
            "quarry"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "fill-color": "#232323"
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "sites",
      "minzoom": 12,
      "paint": {
        "fill-color": "#1c1c1c"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1a1a1a"
      }
    },
    {
      "id": "street_area",
      "type": "fill",
      "source": "openstreetmap",
      "source-layer": "street_polygons",
      "minzoom": 14,
      "paint": {
        "fill-color": "#232323"
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "boundaries",
      "minzoom": 3,
      "paint": {
        "line-color": "#333333",
        "line-width": 0.8
      }
    },
    {
      "id": "street_casing",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "motorway",
            "trunk",
            "primary"
          ],
          true,
          false
        ]
      ],
      "minzoom": 8,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#2b2b2b",
        "line-width": 4.2
      }
    },
    {
      "id": "street_motorway",
