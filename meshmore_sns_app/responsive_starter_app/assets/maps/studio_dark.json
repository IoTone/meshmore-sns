          true,
          false
        ]
      ],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#474747",
        "line-width": 1.1
      }
    },
    {
      "id": "street_service",
      "type": "line",
