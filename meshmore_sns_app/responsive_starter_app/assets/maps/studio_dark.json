      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "motorway"
          ],
          true,
          false
        ]
      ],
      "minzoom": 6,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#6a6a6a",
        "line-width": 2.8
      }
    },
    {
      "id": "street_trunk",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "trunk"
          ],
          true,
          false
        ]
      ],
      "minzoom": 8,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#5e5e5e",
        "line-width": 2.4
      }
    },
    {
      "id": "street_primary",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "primary"
          ],
          true,
          false
        ]
      ],
      "minzoom": 10,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
