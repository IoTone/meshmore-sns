            "get",
            "kind"
          ],
          [
            "service"
          ],
          true,
          false
        ]
      ],
      "minzoom": 14,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3d3d3d",
        "line-width": 0.8
      }
    },
    {
      "id": "street_path",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "footway",
            "path",
            "cycleway",
            "steps",
            "track",
            "pedestrian",
            "bridleway"
          ],
          true,
          false
        ]
      ],
      "minzoom": 13,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": 0.7
      }
    },
    {
      "id": "street_rail",
      "type": "line",
      "source": "openstreetmap",
      "source-layer": "streets",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "==",
          [
            "get",
            "rail"
          ],
          true
        ]
      ],
      "minzoom": 9,
      "layout": {
        "line-cap": "butt"
      },
      "paint": {
        "line-color": "#3f3f3f",
        "line-width": 0.9
      }
    },
    {
      "id": "water_label_line",
      "type": "symbol",
      "source": "openstreetmap",
      "source-layer": "water_lines_labels",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "minzoom": 12,
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Saira"
        ],
        "text-size": 10,
        "text-max-width": 5,
        "text-anchor": "center",
        "symbol-placement": "line",
        "symbol-spacing": 400
      },
      "paint": {
        "text-color": "#6d8ea6",
        "text-halo-color": "#141414",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water_label_point",
      "type": "symbol",
      "source": "openstreetmap",
      "source-layer": "water_polygons_labels",
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "minzoom": 9,
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Saira"
        ],
        "text-size": 11,
        "text-max-width": 5,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#7fa3bd",
        "text-halo-color": "#141414",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "street_label",
      "type": "symbol",
      "source": "openstreetmap",
      "source-layer": "street_labels",
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "minzoom": 13,
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Saira"
        ],
        "text-size": 10.5,
        "text-max-width": 8,
        "text-anchor": "center",
        "symbol-placement": "line",
        "symbol-spacing": 250
      },
      "paint": {
        "text-color": "#b8b8b8",
        "text-halo-color": "#141414",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place_minor",
      "type": "symbol",
      "source": "openstreetmap",
      "source-layer": "place_labels",
      "filter": [
        "all",
        [
          "==",
          "$type",
          "Point"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "village",
            "hamlet",
            "suburb",
            "quarter",
            "neighbourhood",
            "isolated_dwelling"
