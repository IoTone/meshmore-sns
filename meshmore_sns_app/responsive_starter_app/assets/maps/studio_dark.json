      "filter": [
        "all",
        [
          "==",
          "$type",
          "LineString"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "secondary"
          ],
          true,
          false
        ]
      ],
      "minzoom": 11,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
