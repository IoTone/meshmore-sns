<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Map tiles and region archives are cache, not user
     data: they are large (a region file is tens to hundreds of MB) and the
     Auto Backup quota is 25 MB, so backing them up would either fail or
     push hundreds of megabytes to the user's drive for nothing.

     Anything a future feature stores through flutter_secure_storage is a
     credential: its ciphertext (FlutterSecureStorage.xml) is wrapped by an
     Android Keystore key (FlutterSecureKeyStorage.xml), and neither may leave
     the device, because a backup of a credential is an exfiltration path that
     bypasses the platform keystore. Excluded explicitly rather than relying on
     the key being un-restorable. -->
<full-backup-content>
    <exclude domain="file" path="maps/" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
