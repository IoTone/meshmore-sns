<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same reasoning as backup_rules.xml: map data is
     re-downloadable cache and must never leave the device in a backup, and
     the gateway pairing token is a credential whose ciphertext and
     Keystore-wrapped key must not be copied to the cloud or to another
     device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="maps/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="maps/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
