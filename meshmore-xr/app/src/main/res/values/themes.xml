<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HALO FIELD ground, so the window matches the app before Compose draws
         and there is no white flash on launch. -->
    <style name="Theme.MeshmoreXR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF070B10</item>
        <item name="android:statusBarColor">#FF070B10</item>
        <item name="android:navigationBarColor">#FF070B10</item>

        <!-- Splash. minSdk is 34, so the platform attributes are available
             directly and androidx.core:core-splashscreen is not needed.
             The splash shows the same 3D mark as the launcher icon, on the same
             ground colour the app opens into — so launch is a continuous fade,
             not a cut between two different-looking screens. -->
        <item name="android:windowSplashScreenBackground">#FF070B10</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
