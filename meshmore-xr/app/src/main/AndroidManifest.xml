<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRE THE FEATURE THE HARDWARE ACTUALLY REPORTS.
         The app is entirely spatial — horizon, palm reel, crown, console — so
         it must not list on phones, where there is nothing to show and nothing
         to touch. But the first attempt at tightening this required
         `android.software.xr.immersive`, and `pm list features` on the target
         device says:

             android.software.xr.api.spatial=1
             android.software.xr.api.openxr=65538
             android.hardware.xr.input.hand_tracking

         There is no `xr.immersive` on it. Requiring that name would have
         filtered MeshmoreXR off the Aura on Play while installing perfectly
         over adb — a store-only failure, invisible to every test we run here,
         and discovered only because the boot log prints the feature table. -->
    <uses-feature android:name="android.software.xr.api.spatial" android:required="true" />

    <!-- NOT required. §S0's fail-safe is explicit that a denial or an absence
         must degrade to gaze plus head-dwell rather than lock the wearer out,
         and that path is built. A device with the spatial API and no hands is
         a device this app still works on. -->
    <uses-feature android:name="android.hardware.xr.input.hand_tracking"
        android:required="false" />

    <!-- Hand tracking is requested at runtime in a later checkpoint. Declared
         here so the permission model is visible from the start; a denial must
         degrade to gaze+dwell, never error (design brief 8.2 / L6). -->
    <!--
      OPENXR_SYSTEM — the right to ask the system broker which OpenXR runtime
      is active. Protection level `normal`, so declaring it IS granting it; the
      only way to not have it is to not ask.

      Found on the emulator, where the app opened as a flat window and stayed
      there: `isSpatialUiEnabled=false`, requestFullSpace() never returning, and
      one line further up in logcat the actual cause —

        OpenXR-Loader: Exception when querying system content resolver for
        active runtime: SecurityException: Permission Denial ... requires
        org.khronos.openxr.permission.OPENXR_SYSTEM

      Without it the loader finds no runtime, so there is no XR session, so
      spatial capability is false forever and every spatial surface silently
      never builds. The glasses did not need it — their broker answers anyway —
      which is exactly why it went unnoticed: the app was only ever run on the
      one device that tolerates its absence.
    -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <uses-permission android:name="android.permission.HAND_TRACKING" />

    <!--
      SCENE UNDERSTANDING — what lets the app find a real table to stand the
      TABLETOP model on. Runtime-granted (protection level `dangerous`, group
      XR_TRACKING_SENSITIVE), so declaring it only earns the right to ask.

      SPELLED OUT, because there is no constant to reference. It is absent from
      `android.Manifest$permission` in every installed platform including
      android-CANARY — checked, not assumed — while `pm list permissions` on
      the device does report it. So `Manifest.permission.SCENE_UNDERSTANDING_COARSE`
      does not compile and the literal is the only spelling available, here and
      at the checkSelfPermission call.

      COARSE, not FINE. Planes and their labels are all this needs; FINE buys a
      detailed mesh of the room and asks the wearer for a great deal more.
    -->
    <uses-permission android:name="android.permission.SCENE_UNDERSTANDING_COARSE" />

    <!-- MeshCore companion radio over BLE (checkpoint 3). BLUETOOTH_SCAN is
         marked neverForLocation: we derive position from the radio's own
         advert, not from BLE scanning. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!--
        DECLARED SO PLAY DOES NOT INFER THEM AS REQUIRED.

        aapt2 reports these three as `uses-implied-feature` on a build that
        never mentions them: RECORD_AUDIO implies a microphone, ACCESS_*_
        LOCATION implies location hardware, and an implied feature is REQUIRED.
        Play filters the device catalogue on required features, so a permission
        the app asks for politely turns into a hardware demand that can quietly
        remove devices from the listing — the "incompatible with all devices"
        failure, arrived at one implication at a time.

        None of the three is actually required. Dictation is one input path of
        several and the app has a keyboard and a gaze dwell; without a position
        the horizon says NO FIX and still draws every node it has heard by hop
        count. The radio itself is a different case and `android.hardware.
        bluetooth` stays required: this is a client for a Bluetooth radio, and
        an XR device without Bluetooth cannot do the one thing the app is for.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Headset GPS, used ONLY as a fallback when the companion radio has no
         fix of its own, and only when the user has switched it on (Settings.
         useDeviceLocation, off by default). Declared here so the capability is
         visible; never requested unless that path is actually taken. -->
    <!-- Dictation. Requested at the moment the wearer asks to speak, never at
         startup: a microphone prompt on first launch of a mesh radio reads as
         the app wanting to listen to the room. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The whole haptic language — recognition click, refusal double-click,
         the DM thud — threw SecurityException on device until this line
         existed. runCatching ate it quietly; only the sweep's logcat said so.
         Normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- localeConfig puts Meshmore XR in Settings > Apps > Language. Per-app
         locales are opt-in and the opt-in is that attribute; without it a
         tester can only reach Japanese by changing the whole headset's
         language. See res/xml/locales_config.xml. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.MeshmoreXR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.MeshmoreXR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
