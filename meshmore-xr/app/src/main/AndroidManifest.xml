<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRE THE FEATURE THE HARDWARE ACTUALLY REPORTS.
         The app is entirely spatial — horizon, palm reel, crown, console — so
         it must not list on phones, where there is nothing to show and nothing
         to touch. But the first attempt at tightening this required
         `android.software.xr.immersive`, and `pm list features` on the target
         device says:

             android.software.xr.api.spatial=1
             android.software.xr.api.openxr=65538
             android.hardware.xr.input.hand_tracking

         There is no `xr.immersive` on it. Requiring that name would have
         filtered MeshmoreXR off the Aura on Play while installing perfectly
         over adb — a store-only failure, invisible to every test we run here,
         and discovered only because the boot log prints the feature table. -->
    <uses-feature android:name="android.software.xr.api.spatial" android:required="true" />

    <!-- NOT required. §S0's fail-safe is explicit that a denial or an absence
         must degrade to gaze plus head-dwell rather than lock the wearer out,
         and that path is built. A device with the spatial API and no hands is
         a device this app still works on. -->
    <uses-feature android:name="android.hardware.xr.input.hand_tracking"
        android:required="false" />

    <!-- Hand tracking is requested at runtime in a later checkpoint. Declared
         here so the permission model is visible from the start; a denial must
         degrade to gaze+dwell, never error (design brief 8.2 / L6). -->
    <uses-permission android:name="android.permission.HAND_TRACKING" />

    <!-- MeshCore companion radio over BLE (checkpoint 3). BLUETOOTH_SCAN is
         marked neverForLocation: we derive position from the radio's own
         advert, not from BLE scanning. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Headset GPS, used ONLY as a fallback when the companion radio has no
         fix of its own, and only when the user has switched it on (Settings.
         useDeviceLocation, off by default). Declared here so the capability is
         visible; never requested unless that path is actually taken. -->
    <!-- Dictation. Requested at the moment the wearer asks to speak, never at
         startup: a microphone prompt on first launch of a mesh radio reads as
         the app wanting to listen to the room. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:label="MeshmoreXR"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshmoreXR">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.MeshmoreXR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
