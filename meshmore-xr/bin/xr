#!/usr/bin/env bash
# bin/xr — build/install wrapper for MeshmoreXR.
#
# WHY THIS EXISTS: AGP needs JDK 17-21. On this machine the shell's JAVA_HOME is
# Java 11 (too old) and Android Studio *Preview* (Canary, which is the channel
# carrying the XR tools) bundles Java 25 (too new -- the Kotlin plugin throws
# `IllegalArgumentException: 25.0.2`). The only in-range JDK is the STABLE
# Studio's JBR. Use Canary for XR tooling; never let it set JAVA_HOME.
#
#   bin/xr build            assembleDebug
#   bin/xr install          assembleDebug + install + launch on the XR device
#   bin/xr logcat           follow the MeshmoreXR tag
#   bin/xr <gradle task…>
set -uo pipefail
cd "$(dirname "$0")/.."

java_major() { "$1/bin/java" -version 2>&1 | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -1; }
for c in "/Applications/Android Studio.app/Contents/jbr/Contents/Home" \
         "/opt/homebrew/opt/openjdk@21" "/opt/homebrew/opt/openjdk@17" \
         "${JAVA_HOME:-}"; do
  [ -x "$c/bin/java" ] || continue
  m=$(java_major "$c") || continue
  if [ -n "$m" ] && [ "$m" -ge 17 ] && [ "$m" -le 21 ]; then export JAVA_HOME="$c"; break; fi
done
[ -x "${JAVA_HOME:-}/bin/java" ] || { echo "no JDK 17-21 found" >&2; exit 1; }

export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
ADB="$ANDROID_HOME/platform-tools/adb"
PKG=com.iotj.meshmore.xr

# Two devices are usually attached (phone + XR puck); target the XR one unless
# ANDROID_SERIAL is already set.
if [ -z "${ANDROID_SERIAL:-}" ]; then
  # NOTE: `adb shell` reads stdin, so it eats the rest of a `while read` loop's
  # input and only the FIRST device ever gets probed. Feed it /dev/null.
  for s in $("$ADB" devices | awk '/device$/{print $1}'); do
    if "$ADB" -s "$s" shell pm list features </dev/null 2>/dev/null | grep -q xr.api.spatial; then
      XR="$s"; break
    fi
  done
  [ -n "$XR" ] && export ANDROID_SERIAL="$XR"
fi
echo "JAVA_HOME=$JAVA_HOME ($(java_major "$JAVA_HOME"))  device=${ANDROID_SERIAL:-<none>}"

case "${1:-build}" in
  build)   ./gradlew :app:assembleDebug ;;
  install) ./gradlew :app:installDebug \
             && "$ADB" ${ANDROID_SERIAL:+-s $ANDROID_SERIAL} shell monkey -p $PKG -c android.intent.category.LAUNCHER 1 ;;
  logcat)  "$ADB" ${ANDROID_SERIAL:+-s $ANDROID_SERIAL} logcat -s MeshmoreXR:V AndroidRuntime:E ;;
  *)       ./gradlew "$@" ;;
esac
